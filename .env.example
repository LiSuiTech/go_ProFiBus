# ============================================
# Environment Variables Template
# ============================================
# Copy this file to .env and update with your values
# cp .env.example .env
# ============================================

# Application
GO_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json
VERSION=1.0.0

# PostgreSQL Database
POSTGRES_DB=profibus
POSTGRES_USER=profibus
POSTGRES_PASSWORD=profibus_secure_password_change_me
POSTGRES_PORT=5432
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5

# Redis
REDIS_PASSWORD=redis_secure_password_change_me
REDIS_PORT=6379
REDIS_DB=0

# API Server
API_HOST=0.0.0.0
API_PORT=8080
API_MODE=release
API_CORS_ENABLED=true
API_CORS_ORIGINS=*

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=24h
SESSION_DURATION=24h
BCRYPT_COST=10

# Metrics
METRICS_ENABLED=true
METRICS_PORT=8081

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password_change_me
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_PLUGINS=

# Nginx (optional)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Build args
BUILD_TIME=
GIT_COMMIT=
